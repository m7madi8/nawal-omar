# Site
NEXT_PUBLIC_SITE_URL=

# Stripe (existing shop flow)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (server commerce/admin requires URL + SUPABASE_SERVICE_ROLE_KEY — no embedded fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_COMMERCE_ORDERS_TABLE=commerce_orders
SUPABASE_COMMERCE_ORDER_ITEMS_TABLE=commerce_order_items
SUPABASE_PAYMENT_TRANSACTIONS_TABLE=payment_transactions
SUPABASE_PAYMENT_RECEIPTS_TABLE=payment_receipts
SUPABASE_PAYMENT_LEDGER_TABLE=payment_ledger
SUPABASE_BOOKING_AUDIT_TABLE=booking_audit_log

# Signed links for booking status / PDF downloads (set a long random string in production)
BOOKING_ACCESS_SECRET=

# Admin session (required for /admin API routes). Long random string; never expose to the browser.
ADMIN_SESSION_SECRET=
# Required for admin login (no code fallbacks). Rotate if previously exposed in client bundles.
ADMIN_OWNER_USERNAME=nawal
ADMIN_OWNER_PASSWORD=
ADMIN_DEVELOPER_USERNAME=mohammad
ADMIN_DEVELOPER_PASSWORD=
# Bump to invalidate all admin sessions after password rotation (e.g. 1, 2, 3).
ADMIN_AUTH_EPOCH=1
# Team logins (passwords server-only). Optional sourceScope: "wadi-rum" limits data to that retreat.
# [{"username":"shada","password":"…","name":"Shatha","permissions":["overview","retreats"],"sourceScope":"wadi-rum"},{"username":"salma","password":"…","name":"Salma","permissions":["overview","retreats"],"sourceScope":"wadi-rum"}]
ADMIN_TEAM_ACCOUNTS=
# Alias supported: ADMIN_EXTRA_ACCOUNTS

# Server-only Supabase key for commerce/payment writes (never NEXT_PUBLIC_*). Required in production for admin + commerce APIs.
SUPABASE_SERVICE_ROLE_KEY=
# Per-session admin logout revocation (migration 008). Production: enforced when service role is set (DISABLE is ignored).
# Development only: ADMIN_SESSION_REVOCATION_REQUIRED=true to enforce before login; ADMIN_SESSION_REVOCATION_DISABLED=true to skip.
ADMIN_SESSION_REVOCATION_REQUIRED=
ADMIN_SESSION_REVOCATION_DISABLED=

# Deprecated: browser no longer uses this. Remove from production env after Phase A deploy.
# ADMIN_API_KEY=

# deployment: development | staging | production (required on some production hosts when Hyp is enabled)
NAWAL_DEPLOYMENT_MODE=
# Hyp Pay (YaadPay) — https://developers.hyp.co.il/pay
# All card checkout uses live Hyp when HYP_PAYMENTS_ENABLED=true and credentials are set.
# Staging/development: terminal Masof must start with 00100 (test). Production: non-test terminal required.
HYP_PAYMENTS_ENABLED=false
HYP_ENVIRONMENT=production
HYP_TERMINAL_ID=
HYP_API_KEY=
HYP_API_PASSP=
# Must match Hyp Portal “Successful transaction” URL (e.g. https://yoursite.com/api/payment/hyp/return)
HYP_RETURN_URL=
# Optional: HEB | ENG
HYP_PAGE_LANG=HEB
# Leave unset or false = single payment only (no installment dropdown on Hyp page)
# HYP_ALLOW_INSTALLMENTS=false
# Optional payment page template (tmp)
# HYP_PAGE_TEMPLATE=
