# Site
NEXT_PUBLIC_SITE_URL=

# Stripe (existing shop flow)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_COMMERCE_ORDERS_TABLE=commerce_orders
SUPABASE_COMMERCE_ORDER_ITEMS_TABLE=commerce_order_items
SUPABASE_PAYMENT_TRANSACTIONS_TABLE=payment_transactions
SUPABASE_PAYMENT_RECEIPTS_TABLE=payment_receipts
SUPABASE_PAYMENT_LEDGER_TABLE=payment_ledger
SUPABASE_BOOKING_AUDIT_TABLE=booking_audit_log

# Signed links for booking status / PDF downloads (set a long random string in production)
BOOKING_ACCESS_SECRET=
# Protects POST /api/admin/bookings (offline payments, status updates)
ADMIN_API_KEY=

# Hyp Pay (YaadPay) — https://developers.hyp.co.il/pay
# All card checkout uses live Hyp when HYP_PAYMENTS_ENABLED=true and credentials are set.
HYP_PAYMENTS_ENABLED=false
HYP_ENVIRONMENT=test
HYP_TERMINAL_ID=
HYP_API_KEY=
HYP_API_PASSP=
# Must match Hyp Portal “Successful transaction” URL (e.g. https://yoursite.com/api/payment/hyp/return)
HYP_RETURN_URL=
# Optional: HEB | ENG
HYP_PAGE_LANG=HEB
# Optional payment page template (tmp)
# HYP_PAGE_TEMPLATE=
